# Copy to .env and fill in. `make env` does this and generates the secrets for you.
# Never commit .env.

APP_ENV=production

# --- Required secrets (the API refuses to start without them) ---
# 32 random bytes, base64. Encrypts stored credentials. LOSING IT MAKES SAVED KEYS UNRECOVERABLE.
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
# 32+ random characters. Signs login tokens.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=

# --- Database ---
POSTGRES_USER=openclipper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openclipper

# --- Web ---
# Port the web UI is published on (the only published port).
HTTP_PORT=8080
# true when served over HTTPS. Set false for plain http://localhost or http://LAN-IP access.
COOKIE_SECURE=false
# Enables /api/docs. Keep false on anything exposed to the internet.
ENABLE_API_DOCS=false

LOG_LEVEL=INFO

# --- Uploads and media ---
# Largest file a user may upload (bytes). Default 20 GiB.
# MAX_UPLOAD_BYTES=21474836480
# Proxy video used for editing in the browser
# PROXY_HEIGHT=720
# --- Optional: link downloads (profile "ingest"; off until an admin enables it in the app) ---
# Optional proxy for yt-dlp, e.g. http://user:pass@host:port
# YTDLP_PROXY=

# --- AI ---
# Where the included Ollama lives (only change this to use an Ollama running elsewhere).
# OLLAMA_BASE_URL=http://ollama:11434
# After rotating APP_ENCRYPTION_KEY, keep the OLD key here until you have run:
#   docker compose run --rm api python -m app.cli rotate-encryption-key
# APP_ENCRYPTION_KEY_PREVIOUS=
